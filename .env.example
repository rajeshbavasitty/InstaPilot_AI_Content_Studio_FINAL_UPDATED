OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Gemini image generation
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Instagram Login app credentials
# These come from Meta > your app > Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Parent Meta/Facebook app credentials (keep if your Meta setup requires them)
META_APP_ID=
META_APP_SECRET=

# Must exactly match the OAuth redirect URI configured in Meta.
META_REDIRECT_URI=http://127.0.0.1:5000/auth/meta/callback
META_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages

# Optional: if you already generated a token in Graph API Explorer,
# the app will use these values automatically and show Instagram as connected.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Instagram Graph API version used by the test/publish endpoints.
INSTAGRAM_GRAPH_VERSION=v26.0

# Optional public HTTPS origin for generated images.
# Example: https://xxxx.ngrok-free.app
# Leave blank for local preview only.
PUBLIC_BASE_URL=

SECRET_KEY=change-me
